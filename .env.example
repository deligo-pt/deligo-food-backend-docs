# ---------------------------------------------------------------------------
# Documentation content
# ---------------------------------------------------------------------------
# There is nothing to configure. Documentation lives in this repository under
#   content/docs/        (Markdown, discovered recursively)
#   content/changelog.md (optional Change Log source)
#   content/decisions.md (optional Decision Log source)
# It is rendered directly from the working tree at build time.

# ---------------------------------------------------------------------------
# Access control
# ---------------------------------------------------------------------------
# The whole portal is private. All three variables are required for anyone to
# sign in; if any is missing/invalid the site stays locked (fails closed).

# Shared password entered on the /login page. Choose a long, random value and
# distribute it out of band. Never commit the real value. Minimum 16 characters;
# a shorter value makes the site stay locked (fails closed). 32+ recommended.
DOCS_ACCESS_PASSWORD=change-me-to-a-long-random-password

# Secret used to sign the session cookie (HMAC-SHA256). Minimum 16 characters;
# 32+ random bytes recommended. Generate one with:  openssl rand -base64 32
# Rotating this value invalidates all existing sessions.
DOCS_SESSION_SECRET=change-me-generate-with-openssl-rand-base64-32

# Session epoch — a positive integer baked into every issued token. Increment
# it (1 -> 2 -> ...) to immediately revoke ALL existing sessions without
# rotating DOCS_SESSION_SECRET; everyone simply has to sign in again. Must be
# set to a positive integer or the site stays locked (fails closed).
DOCS_AUTH_VERSION=1
